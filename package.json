{
  "name": "marv",
  "version": "6.1.0",
  "description": "A programmatic database migration tool with plugable drivers for mysql, postgres, mssql, sqlite and oracle",
  "main": "index.js",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "prepare": "lefthook install"
  },
  "author": "GuideSmiths Ltd",
  "license": "ISC",
  "dependencies": {
    "async": "^3.2.4",
    "debug": "^4.3.1",
    "xregexp": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "lefthook": "^2.2.1"
  },
  "keywords": [
    "marv",
    "database",
    "db",
    "migration",
    "migrate",
    "postgres",
    "postgresql",
    "mysql",
    "sqlite",
    "sqlite3",
    "mssql",
    "sql server",
    "microsoft sql server",
    "oracle",
    "oracledb"
  ],
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidesmiths/marv.git"
  },
  "bugs": {
    "url": "https://github.com/guidesmiths/marv/issues"
  },
  "homepage": "https://guidesmiths.github.io/marv/"
}
